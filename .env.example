# =============================================================================
# ⚠️ DEPRECATED — v1 遗留 (Node.js + React + Unreal 方案)
# v2 使用 config/voice.yaml，部署见 docs/完整部署指南.md
# 此文件仅供参考，请勿基于此配置开发。
# =============================================================================
HOST=127.0.0.1
PORT=3100
WEB_PORT=5173

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Pixel Streaming signalling page exposed by Unreal locally.
PIXEL_STREAMING_URL=http://127.0.0.1:80

# Stage 2 adapters. Leave disabled until SenseVoice/CosyVoice services are running locally.
ASR_ENABLED=false
ASR_ENDPOINT=http://127.0.0.1:8081/inference
TTS_ENABLED=false
TTS_ENDPOINT=http://127.0.0.1:9880/tts

# Unreal control endpoint for state/emotion/mouth parameters.
UNREAL_CONTROL_ENABLED=false
UNREAL_CONTROL_ENDPOINT=http://127.0.0.1:8765/character

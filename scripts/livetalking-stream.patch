+async def humanaudio_stream(request):
+    """Clocked-v3: route each frame to the current WebRTC session object."""
+    try:
+        sessionid = str(
+            request.query.get('sessionid')
+            or request.headers.get('X-Session-Id', '')
+        )
+        avatar_session = get_session(request, sessionid)
+        if avatar_session is None:
+            return json_error("session not found")
+
+        source_rate = int(request.headers.get('X-Audio-Sample-Rate', '48000'))
+        if source_rate <= 0:
+            return json_error("invalid audio sample rate")
+        target_rate = int(avatar_session.sample_rate)
+        target_chunk = int(avatar_session.chunk)
+        frame_ms = int(request.headers.get('X-Audio-Frame-Ms', '20'))
+        if source_rate != target_rate:
+            return json_error(
+                f"stream must already be resampled to {target_rate} Hz"
+            )
+        if frame_ms != 20:
+            return json_error("LiveTalking requires 20ms audio frames")
+        pending = bytearray()
+        first_frame = True
+        emitted = False
+        bound_session = None
+
+        def emit_frame(frame, status=''):
+            nonlocal bound_session, first_frame
+            current_session = get_session(request, sessionid)
+            if current_session is None:
+                return False
+            if current_session is not bound_session:
+                bound_session = current_session
+                first_frame = True
+                logger.info(
+                    'humanaudio_stream rebound sessionid=%s object=%s',
+                    sessionid, id(current_session)
+                )
+            event_status = status or ('start' if first_frame else '')
+            datainfo = {'status': event_status} if event_status else {}
+            current_session.put_audio_frame(frame, datainfo)
+            first_frame = False
+            return True
+
+        async for data in request.content.iter_chunked(4096):
+            pending.extend(data)
+            frame_bytes = target_chunk * 2
+            while len(pending) >= frame_bytes:
+                frame = np.frombuffer(
+                    bytes(pending[:frame_bytes]), dtype='<i2'
+                ).astype(np.float32) / 32768.0
+                del pending[:frame_bytes]
+                if emit_frame(frame):
+                    emitted = True
+
+        # The app keeps this request open across replies. On application
+        # shutdown, emit one clean zero frame carrying the final event.
+        if emitted:
+            emit_frame(np.zeros(target_chunk, dtype=np.float32), 'end')
+        return json_ok({'sample_rate': target_rate, 'streaming': True})
+    except Exception as e:
+        logger.exception('humanaudio_stream exception:')
+        return json_error(str(e))
